<Window x:Class="ViscerealityCompanion.MinimalRunner.ExperimentRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:companion="clr-namespace:ViscerealityCompanion.App;assembly=ViscerealityCompanion"
        Title="Peripersonal Minimal Experiment Runner"
        Icon="Assets/viscereality-companion-inverted.ico"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <companion:OutcomeKindToBrushConverter x:Key="OutcomeKindToBrush" />
        <companion:OutcomeKindToSoftBrushConverter x:Key="OutcomeKindToSoftBrush" />
        <companion:StatusDetailFormatterConverter x:Key="StatusDetailFormatter" />

        <Style x:Key="CompactPanelBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="RunnerTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SwitchTileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BlockSwitchStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="178" />
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SwitchChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectedSide"
                                        Grid.Column="0"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5" />

                                <TextBlock x:Name="OffLabel"
                                           Grid.Column="0"
                                           Text="Off"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="OnLabel"
                                           Grid.Column="1"
                                           Text="On"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="SelectedSide" Property="Grid.Column" Value="1" />
                                <Setter TargetName="OffLabel" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="OnLabel" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CompactPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Experiment Runner"
                               Style="{StaticResource RunnerTitleStyle}" />
                    <TextBlock Text="{Binding PeripersonalSessionParticipantSummary}"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding PeripersonalSessionFolderLabel}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Image x:Name="MinimalRunnerHeaderLogo"
                       Grid.Column="1"
                       Source="Assets/viscereality-wordmark-inverted.png"
                       Width="128"
                       MaxHeight="68"
                       Stretch="Uniform"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0"
                       AutomationProperties.Name="Viscereality inverted logo" />
                <TextBlock Grid.Column="2"
                           Text="{Binding RecorderStateLabel}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{Binding RecordingLevel, Converter={StaticResource OutcomeKindToBrush}}"
                           VerticalAlignment="Top"
                           Margin="18,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                x:Name="HeadsetUnplugReadyNotice"
                Style="{StaticResource CompactPanelBorderStyle}"
                Background="{StaticResource StatusSuccessSoftBrush}"
                BorderBrush="{StaticResource StatusSuccessBrush}">
            <StackPanel>
                <TextBlock Text="You May Unplug The Headset Now"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{StaticResource StatusSuccessBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="The session is already live: metadata is saved, recording/streams are active, particles are off, and Unity remains the live background for the block switches."
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CompactPanelBorderStyle}"
                Background="{Binding RecordingLevel, Converter={StaticResource OutcomeKindToSoftBrush}}"
                BorderBrush="{Binding RecordingLevel, Converter={StaticResource OutcomeKindToBrush}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding RecordingSummary}"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{Binding RecordingLevel, Converter={StaticResource OutcomeKindToBrush}}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RecordingDetail, Converter={StaticResource StatusDetailFormatter}}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="StartExperimentRecordingButton"
                        Content="Start Experiment"
                        Command="{Binding StartExperimentCommand}"
                        MinWidth="132"
                        MinHeight="38" />
                <Button Grid.Column="3"
                        x:Name="StopExperimentRecordingButton"
                        Content="Stop Experiment"
                        Command="{Binding EndExperimentCommand}"
                        IsEnabled="{Binding CanEndParticipantExperiment}"
                        MinWidth="132"
                        MinHeight="38" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="6"
                     Columns="2"
                     Rows="2">
            <Border Style="{StaticResource CompactPanelBorderStyle}"
                    Background="{Binding ParticlesLevel, Converter={StaticResource OutcomeKindToSoftBrush}}"
                    BorderBrush="{Binding ParticlesLevel, Converter={StaticResource OutcomeKindToBrush}}"
                    Margin="0,0,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Particles"
                                   Style="{StaticResource SwitchTileTitleStyle}" />
                        <TextBlock Text="{Binding ParticlesSummary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2"
                            x:Name="TogglePeripersonalParticlesSwitch"
                            Tag="{Binding IsParticlesToggleState}"
                            Command="{Binding ToggleParticlesCommand}"
                            IsEnabled="{Binding CanToggleParticles}"
                            Style="{StaticResource BlockSwitchStyle}"
                            AutomationProperties.Name="Particle visibility switch" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CompactPanelBorderStyle}"
                    Background="{Binding PeripersonalBlock1Level, Converter={StaticResource OutcomeKindToSoftBrush}}"
                    BorderBrush="{Binding PeripersonalBlock1Level, Converter={StaticResource OutcomeKindToBrush}}"
                    Margin="8,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Block 1"
                                   Style="{StaticResource SwitchTileTitleStyle}" />
                        <TextBlock Text="{Binding PeripersonalBlock1Summary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2"
                            x:Name="TogglePeripersonalBlock1Switch"
                            Tag="{Binding IsPeripersonalBlock1Active}"
                            Command="{Binding TogglePeripersonalBlock1Command}"
                            IsEnabled="{Binding CanTogglePeripersonalBlock1}"
                            Style="{StaticResource BlockSwitchStyle}"
                            AutomationProperties.Name="Block 1 switch" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CompactPanelBorderStyle}"
                    Background="{Binding PeripersonalBlock2Level, Converter={StaticResource OutcomeKindToSoftBrush}}"
                    BorderBrush="{Binding PeripersonalBlock2Level, Converter={StaticResource OutcomeKindToBrush}}"
                    Margin="0,8,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Block 2"
                                   Style="{StaticResource SwitchTileTitleStyle}" />
                        <TextBlock Text="{Binding PeripersonalBlock2Summary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2"
                            x:Name="TogglePeripersonalBlock2Switch"
                            Tag="{Binding IsPeripersonalBlock2Active}"
                            Command="{Binding TogglePeripersonalBlock2Command}"
                            IsEnabled="{Binding CanTogglePeripersonalBlock2}"
                            Style="{StaticResource BlockSwitchStyle}"
                            AutomationProperties.Name="Block 2 switch" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CompactPanelBorderStyle}"
                    Background="{Binding PeripersonalBlock3Level, Converter={StaticResource OutcomeKindToSoftBrush}}"
                    BorderBrush="{Binding PeripersonalBlock3Level, Converter={StaticResource OutcomeKindToBrush}}"
                    Margin="8,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Block 3"
                                   Style="{StaticResource SwitchTileTitleStyle}" />
                        <TextBlock Text="{Binding PeripersonalBlock3Summary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2"
                            x:Name="TogglePeripersonalBlock3Switch"
                            Tag="{Binding IsPeripersonalBlock3Active}"
                            Command="{Binding TogglePeripersonalBlock3Command}"
                            IsEnabled="{Binding CanTogglePeripersonalBlock3}"
                            Style="{StaticResource BlockSwitchStyle}"
                            AutomationProperties.Name="Block 3 switch" />
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="8"
                Style="{StaticResource CompactPanelBorderStyle}"
                Padding="10">
            <TextBlock Text="{Binding LastActionDetail, Converter={StaticResource StatusDetailFormatter}}"
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
