<Window x:Class="ViscerealityCompanion.MinimalRunner.SessionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:companion="clr-namespace:ViscerealityCompanion.App;assembly=ViscerealityCompanion"
        xmlns:runner="clr-namespace:ViscerealityCompanion.MinimalRunner"
        Title="Peripersonal Session Setup"
        Icon="Assets/viscereality-companion-inverted.ico"
        Width="540"
        Height="620"
        MinWidth="520"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <companion:OutcomeKindToBrushConverter x:Key="OutcomeKindToBrush" />
        <companion:OutcomeKindToSoftBrushConverter x:Key="OutcomeKindToSoftBrush" />
        <companion:StatusDetailFormatterConverter x:Key="StatusDetailFormatter" />
        <runner:HandednessToIsLeftConverter x:Key="HandednessToIsLeft" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HandednessSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="260" />
            <Setter Property="Height" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="SwitchChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectedSide"
                                        Grid.Column="1"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5" />

                                <TextBlock x:Name="LeftLabel"
                                           Grid.Column="0"
                                           Text="Left"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="RightLabel"
                                           Grid.Column="1"
                                           Text="Right"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedSide" Property="Grid.Column" Value="0" />
                                <Setter TargetName="LeftLabel" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="RightLabel" Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Start Session"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Enter participant variables, keep the headset connected, then start the live setup."
                               Style="{StaticResource SectionCaptionStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Image x:Name="MinimalRunnerSetupLogo"
                       Grid.Column="1"
                       Source="Assets/viscereality-wordmark-inverted.png"
                       Width="146"
                       MaxHeight="92"
                       Stretch="Uniform"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0"
                       AutomationProperties.Name="Viscereality inverted logo" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="HeadsetPluggedSetupNotice"
                        Style="{StaticResource PanelBorderStyle}"
                        Background="{StaticResource StatusWarningSoftBrush}"
                        BorderBrush="{StaticResource StatusWarningBrush}">
                    <StackPanel>
                        <TextBlock Text="Keep Headset Plugged In For This Step"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource StatusWarningBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Start Session launches Unity, sends metadata, starts recording/streams, forces particles off, and opens Block 1. Wait for the next window before unplugging."
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Participant Name"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PreparationParticipantNameTextBox"
                                 Text="{Binding PeripersonalParticipantNameDraft, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0" />

                        <TextBlock Text="Participant Number"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,12,0,0" />
                        <Grid Margin="0,6,0,0"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    MinHeight="58"
                                    Padding="14,0">
                                <TextBlock x:Name="PreparationParticipantNumberDisplay"
                                           Text="{Binding PeripersonalParticipantNumberDisplay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <Grid Grid.Column="1"
                                  Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button x:Name="IncreaseParticipantNumberButton"
                                        Grid.Row="0"
                                        Content="&#x25B2;"
                                        Command="{Binding IncreasePeripersonalParticipantNumberCommand}"
                                        IsEnabled="{Binding CanIncreasePeripersonalParticipantNumber}"
                                        MinWidth="36"
                                        MinHeight="25"
                                        Padding="0"
                                        AutomationProperties.Name="Increase participant number" />
                                <Button x:Name="DecreaseParticipantNumberButton"
                                        Grid.Row="2"
                                        Content="&#x25BC;"
                                        Command="{Binding DecreasePeripersonalParticipantNumberCommand}"
                                        IsEnabled="{Binding CanDecreasePeripersonalParticipantNumber}"
                                        MinWidth="36"
                                        MinHeight="25"
                                        Padding="0"
                                        AutomationProperties.Name="Decrease participant number" />
                            </Grid>
                        </Grid>

                        <TextBlock Text="Age"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,12,0,0" />
                        <TextBox x:Name="PreparationAgeTextBox"
                                 Text="{Binding PeripersonalParticipantAgeDraft, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0" />

                        <TextBlock Text="Handedness"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,12,0,0" />
                        <ToggleButton x:Name="PreparationHandednessSwitch"
                                      IsChecked="{Binding PeripersonalHandednessDraft, Mode=TwoWay, Converter={StaticResource HandednessToIsLeft}, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource HandednessSwitchStyle}"
                                      Margin="0,6,0,0"
                                      AutomationProperties.Name="Handedness switch" />
                        <TextBlock Text="{Binding PeripersonalBreathControllerSideLabel}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorderStyle}"
                        Background="{Binding PeripersonalWorkflowLevel, Converter={StaticResource OutcomeKindToSoftBrush}}"
                        BorderBrush="{Binding PeripersonalWorkflowLevel, Converter={StaticResource OutcomeKindToBrush}}"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ParticipantEntrySummary}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{Binding ParticipantEntryLevel, Converter={StaticResource OutcomeKindToBrush}}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ParticipantEntryDetail}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ParticipantExistingSessionsLabel}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding ParticipantHasExistingSessions, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding PeripersonalWorkflowSummary}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{Binding PeripersonalWorkflowLevel, Converter={StaticResource OutcomeKindToBrush}}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PeripersonalWorkflowDetail, Converter={StaticResource StatusDetailFormatter}}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="JSON file"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding PeripersonalPreparationFilePath}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding LastTwinStateTimestampLabel}"
                       Style="{StaticResource SectionCaptionStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    MinWidth="96"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button x:Name="StartSessionButton"
                    Grid.Column="3"
                    Content="Start Session"
                    MinWidth="130"
                    IsDefault="True"
                    IsEnabled="{Binding CanSavePeripersonalSessionPreparation}"
                    Click="StartSessionButton_Click" />
        </Grid>
    </Grid>
</Window>
